# ---- API ----
# Leave VITE_API_URL EMPTY to go through the Vite dev proxy (same-origin).
# This is what you want locally: the session cookie is never cross-site, so
# CORS does not apply. The proxy target comes from VITE_API_PROXY_TARGET below.
VITE_API_URL=

# Where the dev proxy forwards /api/* to. Must be the same host you actually
# want to develop against.
VITE_API_PROXY_TARGET=https://marcus-confidence-principles-hit.trycloudflare.com

# ---- AI API ----
VITE_API_AI_URL=https://ai-serv5.fastapicloud.dev/api/v1